# ─── Configuration VisioOne ───────────────────────────────────────────────
#
# Copiez ce fichier en .env et renseignez l'URL fournie par Visioglobe.
#
#   cp .env.example .env
#
# Les variables préfixées EXPO_PUBLIC_ sont accessibles dans le code via
# process.env['EXPO_PUBLIC_VISIOONE_URL'].
#
# Référence : https://docs.expo.dev/guides/environment-variables/

EXPO_PUBLIC_VISIOONE_URL=https://cdn.visioglobe.com/visioone/latest/apps/demo/?hash=k0c77e25bdfdce74afc69f677bc1f826791eac441
